# ==============================================================
# 复制为 .env 后按环境填写。
# 变量名须与 app/config.py 字段一致（大小写不敏感）。
# 完整对照表：docs/config.md
# ==============================================================

# ---------- 大模型（必选，OpenAI 兼容）----------
AIROBOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIROBOT_LLM_API_KEY=
AIROBOT_LLM_MODEL=qwen-plus
AIROBOT_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIROBOT_EMBEDDING_API_KEY=
AIROBOT_EMBEDDING_MODEL=text-embedding-v3

# 可选：本地 Ollama（启用时改用下面并注释上面的 DashScope）
# AIROBOT_LLM_BASE_URL=http://localhost:11434/v1
# AIROBOT_LLM_API_KEY=ollama
# AIROBOT_LLM_MODEL=qwen2.5:1.5b
# AIROBOT_EMBEDDING_BASE_URL=http://localhost:11434/v1
# AIROBOT_EMBEDDING_API_KEY=ollama
# AIROBOT_EMBEDDING_MODEL=nomic-embed-text

# 兼容别名（可省略；省略时自动等于 AIROBOT_EMBEDDING_*）
# embedding_base_url=
# embedding_api_key=
# embedding_model=

# LLM provider（langchain init_chat_model）
PROVIDER=openai

# ---------- PostgreSQL（必选，须带 asyncpg 驱动前缀）----------
POSTGRES_URI=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/postgres

# ---------- Milvus ----------
MILVUS_URI=http://localhost:19530
COLLECTION_NAME=customer_milvus_collection
DIM=1024

# ---------- RAG / 分块（TOP_K / CHUNK_* 必填）----------
TOP_K=5
CHUNK_SIZE=400
CHUNK_OVERLAP=80
PDF_CHUNK_SIZE=800
PDF_CHUNK_OVERLAP=80
PDF_SECTION_MAX_CHARS=1000
PDF_SECTION_MIN_CHARS=150

# ---------- 混合检索 / 重排 ----------
HYBRID_ENABLED=true
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_FUSION_TOP_K=20
RERANK_ENABLED=false
RERANK_PROVIDER=local
RERANK_MODEL=qwen3.7-text-rerank
# RERANK_API_KEY=

# ---------- Crew / 会话 / 稳定性 ----------
USE_CREW=false
CREW_TOOLS_READY=true
MEMORY_MAX_TURNS=5
RETRY_ATTEMPTS=3
RETRY_MAX_WAIT=3
TOOL_TIMEOUT_SEC=30
# Mock 订单失败率（0~1）；默认 0，混沌演示可设 0.6
ORDER_MOCK_FAIL_RATE=0
RATELIMIT_ENABLED=true
RATELIMIT_PER_MINUTE=30
CACHE_ENABLED=true
CACHE_THRESHOLD=0.75
CACHE_LEXICAL_THRESHOLD=0.5
MAX_ENTRIES_CACHE=1000
API_KEY_ENABLED=false
# SERVICE_API_KEY=
DEBUG=true
APP_VERSION=0.1.0

# ---------- 告警 Agent：MCP → 浏览器 → 正文 ----------
ALARM_MCP_ENABLED=true
ALARM_MCP_HOST=pre-mcp.alibaba-inc.com
ALARM_MCP_PATH=/info-plate-mcp/mcp
ALARM_MCP_TOKEN=
ALARM_MCP_TIMEOUT_SEC=15
ALARM_MCP_VERIFY_SSL=false

ALARM_BROWSER_ENABLED=true
ALARM_BROWSER_PROFILE_DIR=.browser_profile
ALARM_INFO_PLATE_USER=
ALARM_INFO_PLATE_PASSWORD=
ALARM_BROWSER_TIMEOUT_SEC=120
ALARM_BROWSER_HEADLESS=true
ALARM_INFO_PLATE_BASE_URL=https://info-plate.fc.alibaba-inc.com

ALARM_SKIP_WHEN_ZERO_COUNT=true
ALARM_REPORT_FORMAT=markdown
ALARM_MOCK_ENABLED=false

ALARM_REPLAN_ENABLED=false
ALARM_DETAIL_PAGE_SIZE=20
ALARM_REPLAN_MAX_PAGES=2
ALARM_REPLAN_MAX_PLAYBOOK_SWITCH=1

# ---------- 闲聊：高德 MCP / 天气 ----------
AMAP_MCP_ENABLED=false
AMAP_MAPS_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp
# WEATHER_API_KEY=

# Windows 控制台若因 emoji/中文崩溃，启动前设：
#   $env:PYTHONUTF8="1"; $env:PYTHONIOENCODING="utf-8"
